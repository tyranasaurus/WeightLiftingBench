      "out": 4,
      "kernel": [
        5,
        5
      ],
      "stride": 1,
      "padding": 2
    },
    {
      "name": "open_spaces",
      "op": "relu",
      "inputs": [
        "gap_boundaries"
      ]
    },
    {
      "name": "shoe_height_samples",
      "op": "dense",
      "inputs": [
        "silhouette_grid"
      ],
      "out": 945
