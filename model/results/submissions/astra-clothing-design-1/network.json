    {
      "name": "nearby_fabric",
      "op": "maxpool",
      "inputs": [
        "border_for_envelope"
      ],
      "size": [
        5,
        5
      ],
      "stride": [
        1,
        1
      ]
    },
    {
      "name": "inverted_envelope",
      "op": "conv",
      "inputs": [
        "nearby_fabric"
      ],
      "out": 1,
      "kernel": [
        1,
        1
      ],
      "stride": 1,
      "padding": 2
    },
    {
      "name": "trim_envelope",
      "op": "maxpool",
