    {
      "name": "shoe_scan_sets",
      "op": "reshape",
      "inputs": [
        "shoe_height_samples"
      ],
      "shape": [
        1,
        35,
        27
      ]
    },
    {
      "name": "shoe_top_lines",
      "op": "maxpool",
      "inputs": [
        "shoe_scan_sets"
      ],
      "size": [
        1,
        27
      ],
      "stride": [
        1,
        27
      ]
    },
    {
      "name": "enclosed_space_maps",
      "op": "dense",
      "inputs": [
        "shape_measurements"
      ],
      "out": 392
