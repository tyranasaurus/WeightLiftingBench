    {
      "name": "light",
      "op": "add",
      "inputs": [
        "linear_light",
        "relative_light"
      ]
    },
    {
      "name": "local_contrasts",
      "op": "conv",
      "inputs": [
        "light"
      ],
      "out": 8,
      "kernel": [
        5,
        5
      ],
