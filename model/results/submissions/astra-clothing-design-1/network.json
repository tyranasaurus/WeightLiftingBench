{
  "layers": [
    {
      "name": "foreground_hinges",
      "op": "conv",
      "inputs": [
        "image"
      ],
      "out": 3,
      "kernel": [
        1,
        1
      ],
      "stride": 1,
      "padding": 0
    },
    {
      "name": "foreground_pos",
      "op": "relu",
      "inputs": [
        "foreground_hinges"
      ]
    },
    {
      "name": "fabric",
      "op": "conv",
      "inputs": [
        "foreground_pos"
      ],
      "out": 1,
      "kernel": [
        1,
        1
      ],
      "stride": 1,
      "padding": 0
    },
    {
      "name": "silhouette_grid",
      "op": "avgpool",
      "inputs": [
        "fabric"
      ],
      "size": [
        2,
        2
      ],
      "stride": [
        2,
        2
      ]
    },
    {
      "name": "scanline_padding",
      "op": "dense",
      "inputs": [
        "silhouette_grid"
      ],
      "out": 1120
    },
    {
      "name": "scanlines",
      "op": "reshape",
      "inputs": [
        "scanline_padding"
      ],
      "shape": [
        1,
        28,
        40
      ]
    },
    {
      "name": "scanline_maxima",
      "op": "maxpool",
      "inputs": [
        "scanlines"
      ],
      "size": [
        1,
        14
      ],
      "stride": [
        1,
        1
      ]
    },
    {
      "name": "envelope_sides",
      "op": "dense",
      "inputs": [
        "scanline_maxima"
      ],
      "out": 784
    },
    {
      "name": "scanline_positive",
      "op": "relu",
      "inputs": [
        "envelope_sides"
      ]
    },
    {
      "name": "extent_grids",
      "op": "dense",
      "inputs": [
        "scanline_positive"
      ],
      "out": 588
    },
    {
      "name": "unfilled_grid",
      "op": "dense",
      "inputs": [
        "silhouette_grid"
      ],
      "out": 588
    },
    {
      "name": "shape_measurements",
      "op": "add",
      "inputs": [
        "extent_grids",
