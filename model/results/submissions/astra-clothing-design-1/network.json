    {
      "name": "best_cut",
      "op": "maxpool",
      "inputs": [
        "pattern_families"
      ],
      "size": [
        1,
        1024
      ],
      "stride": [
        1,
        1024
      ]
    },
    {
      "name": "outline_vote",
      "op": "reshape",
      "inputs": [
        "best_cut"
      ],
      "shape": [
        10
      ]
    },
    {
      "name": "exposure",
      "op": "norm",
      "inputs": [
        "image"
      ]
    },
    {
      "name": "linear_light",
      "op": "conv",
      "inputs": [
        "image"
      ],
      "out": 1,
      "kernel": [
        1,
        1
      ],
      "stride": 1,
      "padding": 0
    },
    {
      "name": "relative_light",
      "op": "conv",
      "inputs": [
        "exposure"
      ],
      "out": 1,
      "kernel": [
        1,
        1
      ],
      "stride": 1,
      "padding": 0
