    {
      "name": "enclosed_spaces",
      "op": "reshape",
      "inputs": [
        "enclosed_space_maps"
      ],
      "shape": [
        2,
        14,
        14
      ]
    },
    {
      "name": "read_columns_used",
      "op": "dense",
      "inputs": [
        "columns_used"
      ],
      "out": 302
    },
    {
      "name": "read_rows_used",
      "op": "dense",
      "inputs": [
        "rows_used"
      ],
      "out": 302
    },
    {
      "name": "read_fabric",
      "op": "dense",
      "inputs": [
        "fabric"
      ],
      "out": 302
    },
    {
      "name": "read_oriented_flanks",
      "op": "dense",
      "inputs": [
        "oriented_flanks"
      ],
      "out": 302
    },
    {
      "name": "read_fabric_envelope",
      "op": "dense",
      "inputs": [
        "fabric_envelope"
      ],
      "out": 302
    },
    {
      "name": "read_inner_fabric_edges",
      "op": "dense",
      "inputs": [
        "inner_fabric_edges"
      ],
      "out": 302
    },
    {
      "name": "read_rectified_contrasts",
      "op": "dense",
      "inputs": [
        "rectified_contrasts"
      ],
      "out": 302
    },
    {
      "name": "read_light",
      "op": "dense",
      "inputs": [
        "light"
      ],
      "out": 302
    },
    {
      "name": "read_open_spaces",
      "op": "dense",
      "inputs": [
        "open_spaces"
      ],
      "out": 302
    },
    {
      "name": "read_shoe_top_lines",
      "op": "dense",
      "inputs": [
        "shoe_top_lines"
      ],
      "out": 302
    },
    {
      "name": "read_enclosed_spaces",
      "op": "dense",
      "inputs": [
        "enclosed_spaces"
      ],
      "out": 302
    },
    {
      "name": "observations",
      "op": "add",
      "inputs": [
        "read_columns_used",
        "read_rows_used",
        "read_fabric",
        "read_oriented_flanks",
        "read_fabric_envelope",
        "read_inner_fabric_edges",
        "read_rectified_contrasts",
        "read_light",
        "read_open_spaces",
        "read_shoe_top_lines",
        "read_enclosed_spaces"
      ]
    },
    {
      "name": "evidence_ramps",
      "op": "dense",
      "inputs": [
        "observations"
      ],
      "out": 290
    },
    {
      "name": "evidence_positive",
      "op": "relu",
      "inputs": [
        "evidence_ramps"
      ]
    },
    {
      "name": "local_combinations",
      "op": "dense",
      "inputs": [
        "evidence_positive"
      ],
      "out": 314
    },
    {
      "name": "construction_positive",
      "op": "relu",
      "inputs": [
        "local_combinations"
      ]
    },
    {
      "name": "construction_vote",
      "op": "dense",
      "inputs": [
        "construction_positive"
      ],
      "out": 10
    },
    {
      "name": "family_evidence",
      "op": "dense",
      "inputs": [
        "construction_positive"
      ],
      "out": 10
    },
    {
      "name": "style_hypotheses",
      "op": "add",
      "inputs": [
        "outline_vote",
        "construction_vote"
      ]
    },
    {
      "name": "shape_hypotheses",
      "op": "add",
      "inputs": [
        "outline_vote",
        "family_evidence"
      ]
    },
    {
      "name": "style_collect",
      "op": "dense",
      "inputs": [
        "style_hypotheses"
      ],
      "out": 20
    },
    {
      "name": "style_sets",
      "op": "reshape",
      "inputs": [
        "style_collect"
      ],
      "shape": [
        1,
        5,
        4
      ]
    },
    {
      "name": "style_max",
      "op": "maxpool",
      "inputs": [
        "style_sets"
      ],
      "size": [
        1,
        4
      ],
      "stride": [
        1,
        4
      ]
    },
    {
      "name": "style_broadcast",
      "op": "dense",
      "inputs": [
        "style_max"
      ],
      "out": 10
    },
    {
      "name": "family_collect",
      "op": "dense",
      "inputs": [
        "shape_hypotheses"
      ],
      "out": 20
    },
    {
      "name": "family_sets",
      "op": "reshape",
      "inputs": [
        "family_collect"
      ],
      "shape": [
        1,
        5,
        4
      ]
    },
    {
      "name": "family_max",
      "op": "maxpool",
      "inputs": [
        "family_sets"
      ],
      "size": [
        1,
        4
      ],
      "stride": [
        1,
        4
      ]
    },
    {
      "name": "family_broadcast",
      "op": "dense",
      "inputs": [
        "family_max"
      ],
      "out": 10
    },
    {
      "name": "remove_local_max",
      "op": "dense",
      "inputs": [
        "style_broadcast"
      ],
      "out": 10
    },
    {
      "name": "restore_shape_max",
      "op": "dense",
      "inputs": [
        "family_broadcast"
      ],
      "out": 10
    },
    {
      "name": "family_calibration",
      "op": "add",
      "inputs": [
        "remove_local_max",
        "restore_shape_max"
      ]
    },
    {
      "name": "scores",
      "op": "add",
      "inputs": [
        "style_hypotheses",
        "family_calibration"
      ]
    }
  ]
}
