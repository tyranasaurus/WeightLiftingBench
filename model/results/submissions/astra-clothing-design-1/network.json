        "inverted_envelope"
      ],
      "size": [
        5,
        5
      ],
      "stride": [
        1,
        1
      ]
    },
    {
      "name": "fabric_envelope",
      "op": "conv",
      "inputs": [
        "trim_envelope"
      ],
      "out": 1,
      "kernel": [
        1,
        1
      ],
      "stride": 1,
      "padding": 0
    },
    {
      "name": "silhouette_flanks",
      "op": "conv",
      "inputs": [
        "fabric_envelope"
      ],
      "out": 2,
      "kernel": [
        3,
        3
      ],
      "stride": 1,
      "padding": 1
    },
    {
      "name": "oriented_flanks",
      "op": "relu",
      "inputs": [
        "silhouette_flanks"
      ]
    },
    {
      "name": "columns_used",
      "op": "maxpool",
      "inputs": [
        "fabric"
      ],
      "size": [
        28,
        1
      ],
      "stride": [
        28,
        1
      ]
    },
    {
      "name": "rows_used",
      "op": "maxpool",
      "inputs": [
        "fabric"
      ],
      "size": [
        1,
        28
      ],
      "stride": [
        1,
        28
      ]
    },
    {
      "name": "raw_flank_signs",
      "op": "conv",
      "inputs": [
        "fabric"
      ],
      "out": 2,
      "kernel": [
        3,
        3
      ],
      "stride": 1,
      "padding": 1
    },
    {
      "name": "inner_fabric_edges",
      "op": "relu",
      "inputs": [
        "raw_flank_signs"
      ]
    },
    {
      "name": "gap_boundaries",
