      ],
      "out": 4,
      "kernel": [
        1,
        1
      ],
      "stride": 1,
      "padding": 0
    },
    {
      "name": "poolc",
      "op": "avgpool",
      "inputs": [
        "color"
      ],
      "size": [
        8,
        8
      ],
      "stride": [
        8,
        8
      ]
    },
    {
      "name": "det",
