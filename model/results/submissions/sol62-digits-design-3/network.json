      "inputs": [
        "positive"
      ],
      "out": 1,
      "kernel": [
        1,
        1
      ]
    },
    {
      "name": "coarse",
      "op": "avgpool",
      "inputs": [
        "ink"
      ],
      "size": [
        2,
        2
      ],
      "stride": [
        2,
        2
      ]
    },
    {
      "name": "near",
      "op": "maxpool",
      "inputs": [
        "coarse"
      ],
      "size": [
        3,
        3
      ],
      "stride": [
        1,
        1
      ]
    },
    {
      "name": "raw_grid",
      "op": "reshape",
      "inputs": [
        "coarse"
      ],
      "shape": [
        1,
        1,
        196
      ]
    },
    {
      "name": "near_grid",
      "op": "reshape",
      "inputs": [
        "near"
      ],
      "shape": [
        1,
        1,
        144
      ]
    },
    {
      "name": "local_match",
      "op": "dense",
      "inputs": [
        "raw_grid"
      ],
      "out": 10240
    },
    {
      "name": "tolerant_match",
      "op": "dense",
