      "op": "relu",
      "inputs": [
        "placket_contrast"
      ]
    },
    {
      "name": "placket_grid",
      "op": "reshape",
      "inputs": [
        "positive_placket"
      ],
      "shape": [
        1,
        12,
        3
      ]
    },
    {
      "name": "negative_placket",
      "op": "conv",
      "inputs": [
        "placket_grid"
      ],
      "out": 1,
      "kernel": [
        1,
        1
      ],
      "stride": 1,
      "padding": 0
    },
    {
      "name": "weakest_placket_band",
      "op": "maxpool",
      "inputs": [
        "negative_placket"
      ],
      "size": [
        1,
        3
      ],
      "stride": [
        1,
        3
      ]
    },
    {
      "name": "continuous_placket",
      "op": "conv",
      "inputs": [
        "weakest_placket_band"
      ],
      "out": 1,
      "kernel": [
        1,
        1
      ],
      "stride": 1,
      "padding": 0
    },
    {
      "name": "best_placket",
      "op": "maxpool",
      "inputs": [
        "continuous_placket"
      ],
      "size": [
        12,
        1
      ],
      "stride": [
        12,
        1
      ]
    },
    {
      "name": "placket_threshold",
      "op": "dense",
      "inputs": [
        "best_placket"
      ],
      "out": 1
    },
    {
      "name": "clear_placket",
      "op": "relu",
      "inputs": [
        "placket_threshold"
      ]
    },
    {
      "name": "opening_evidence",
      "op": "dense",
      "inputs": [
        "clear_placket"
      ],
      "out": 10
    },
    {
      "name": "construction_regions",
      "op": "dense",
      "inputs": [
        "foreground"
      ],
      "out": 20
    },
    {
      "name": "construction_tests",
      "op": "dense",
      "inputs": [
        "construction_regions"
      ],
      "out": 9
    },
    {
      "name": "construction_gates",
      "op": "relu",
      "inputs": [
        "construction_tests"
      ]
    },
    {
      "name": "construction_evidence",
      "op": "dense",
      "inputs": [
        "construction_gates"
      ],
      "out": 10
    },
    {
      "name": "collar_contrasts",
      "op": "dense",
      "inputs": [
        "contrast_normalized"
      ],
      "out": 54
    },
    {
      "name": "collar_relu",
      "op": "relu",
      "inputs": [
        "collar_contrasts"
      ]
    },
    {
      "name": "collar_grid",
      "op": "reshape",
      "inputs": [
        "collar_relu"
      ],
      "shape": [
        2,
        1,
        27
      ]
    },
    {
      "name": "best_collar",
      "op": "maxpool",
      "inputs": [
        "collar_grid"
      ],
      "size": [
        1,
        27
      ],
      "stride": [
        1,
        27
      ]
    },
    {
      "name": "collar_evidence",
      "op": "dense",
      "inputs": [
        "best_collar"
      ],
      "out": 10
    },
    {
      "name": "horizontal_extent",
      "op": "maxpool",
      "inputs": [
        "foreground"
      ],
      "size": [
        28,
        1
      ],
      "stride": [
        28,
        1
      ]
    },
    {
      "name": "vertical_extent",
      "op": "maxpool",
      "inputs": [
        "foreground"
      ],
      "size": [
        1,
        28
      ],
      "stride": [
        1,
        28
      ]
    },
    {
      "name": "footwear_span",
      "op": "dense",
      "inputs": [
        "vertical_extent"
      ],
      "out": 1
    },
    {
      "name": "footwear_area",
      "op": "dense",
      "inputs": [
        "foreground"
      ],
      "out": 1
    },
    {
      "name": "span_density_term",
      "op": "dense",
      "inputs": [
        "footwear_span"
      ],
      "out": 1
    },
    {
      "name": "area_density_term",
      "op": "dense",
      "inputs": [
        "footwear_area"
      ],
      "out": 1
    },
    {
      "name": "openness",
      "op": "add",
      "inputs": [
        "span_density_term",
        "area_density_term"
      ]
    },
    {
      "name": "open_strap_test",
      "op": "dense",
      "inputs": [
        "openness"
      ],
      "out": 1
    },
    {
      "name": "open_strap_gate",
      "op": "relu",
      "inputs": [
        "open_strap_test"
      ]
    },
    {
      "name": "open_strap_evidence",
      "op": "dense",
      "inputs": [
        "open_strap_gate"
      ],
      "out": 10
    },
    {
      "name": "closed_vamp_test",
      "op": "dense",
      "inputs": [
        "openness"
      ],
      "out": 1
    },
    {
      "name": "closed_vamp_gate",
      "op": "relu",
      "inputs": [
        "closed_vamp_test"
      ]
    },
    {
      "name": "closed_vamp_evidence",
      "op": "dense",
      "inputs": [
        "closed_vamp_gate"
      ],
      "out": 10
    },
    {
      "name": "class_scores",
      "op": "add",
      "inputs": [
        "shape_scores",
        "opening_evidence",
        "construction_evidence",
        "collar_evidence",
        "open_strap_evidence",
        "closed_vamp_evidence"
      ]
    }
  ]
}