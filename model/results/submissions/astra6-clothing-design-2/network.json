{
  "layers": [
    {
      "name": "signed_image",
      "op": "conv",
      "inputs": [
        "image"
      ],
      "out": 2,
      "kernel": [
        1,
        1
      ],
      "stride": 1,
      "padding": 0
    },
    {
      "name": "signed_plane",
      "op": "reshape",
      "inputs": [
        "signed_image"
      ],
      "shape": [
        1,
        56,
        28
      ]
    },
    {
      "name": "rms_normalized",
      "op": "norm",
      "inputs": [
        "signed_plane"
      ]
    },
    {
      "name": "signed_channels",
      "op": "reshape",
      "inputs": [
        "rms_normalized"
      ],
      "shape": [
        2,
        28,
        28
      ]
    },
    {
      "name": "relative_intensity",
      "op": "conv",
      "inputs": [
        "signed_channels"
      ],
      "out": 1,
      "kernel": [
        1,
        1
      ],
      "stride": 1,
      "padding": 0
    },
    {
      "name": "thresholds",
      "op": "conv",
      "inputs": [
        "relative_intensity"
      ],
      "out": 4,
      "kernel": [
        1,
        1
      ],
      "stride": 1,
      "padding": 0
    },
    {
      "name": "threshold_relu",
      "op": "relu",
      "inputs": [
        "thresholds"
      ]
    },
    {
      "name": "foreground",
      "op": "conv",
      "inputs": [
        "threshold_relu"
      ],
      "out": 1,
      "kernel": [
        1,
        1
      ],
      "stride": 1,
      "padding": 0
    },
    {
      "name": "pad_foreground",
      "op": "conv",
      "inputs": [
        "foreground"
      ],
      "out": 1,
      "kernel": [
        1,
        1
      ],
      "stride": 1,
      "padding": 2
    },
    {
      "name": "dilate",
      "op": "maxpool",
      "inputs": [
        "pad_foreground"
      ],
      "size": [
        3,
        3
      ],
      "stride": [
        1,
        1
      ]
    },
    {
      "name": "negative_dilation",
      "op": "conv",
      "inputs": [
        "dilate"
      ],
      "out": 1,
      "kernel": [
        1,
        1
      ],
      "stride": 1,
      "padding": 0
    },
    {
      "name": "negative_closing",
      "op": "maxpool",
      "inputs": [
        "negative_dilation"
      ],
      "size": [
        3,
        3
      ],
      "stride": [
        1,
        1
      ]
    },
    {
      "name": "closed",
      "op": "conv",
      "inputs": [
        "negative_closing"
      ],
      "out": 1,
      "kernel": [
        1,
        1
      ],
      "stride": 1,
      "padding": 0
    },
    {
      "name": "closed_weight",
      "op": "conv",
      "inputs": [
        "closed"
      ],
      "out": 1,
      "kernel": [
        1,
        1
      ],
      "stride": 1,
      "padding": 0
    },
    {
      "name": "foreground_weight",
      "op": "conv",
      "inputs": [
        "foreground"
      ],
      "out": 1,
      "kernel": [
        1,
        1
      ],
      "stride": 1,
      "padding": 0
    },
    {
      "name": "shape_occupancy",
      "op": "add",
      "inputs": [
        "closed_weight",
        "foreground_weight"
      ]
    },
    {
      "name": "shape_image",
      "op": "avgpool",
      "inputs": [
        "shape_occupancy"
      ],
      "size": [
        2,
        2
      ],
      "stride": [
        2,
        2
      ]
    },
    {
      "name": "geometric_compatibility",
      "op": "dense",
      "inputs": [
        "shape_image"
      ],
      "out": 3780
    },
    {
      "name": "geometric_grid",
      "op": "reshape",
      "inputs": [
        "geometric_compatibility"
      ],
      "shape": [
        10,
        1,
        378
      ]
    },
    {
      "name": "best_geometry",
      "op": "maxpool",
      "inputs": [
        "geometric_grid"
      ],
      "size": [
        1,
        378
      ],
      "stride": [
        1,
        378
      ]
    },
    {
      "name": "shape_scores",
      "op": "reshape",
      "inputs": [
        "best_geometry"
      ],
      "shape": [
        10
      ]
    },
    {
      "name": "contrast_normalized",
      "op": "norm",
      "inputs": [
        "image"
      ]
    },
    {
      "name": "placket_contrast",
      "op": "dense",
      "inputs": [
        "contrast_normalized"
      ],
