        2
      ],
      "stride": [
        2,
        2
      ]
    },
    {
      "name": "sharp_norm",
      "op": "norm",
      "inputs": [
        "sharp_small"
      ]
    },
    {
      "name": "soft_small",
      "op": "avgpool",
      "inputs": [
        "blur"
      ],
      "size": [
        2,
        2
      ],
      "stride": [
        2,
        2
      ]
    },
    {
      "name": "soft_norm",
      "op": "norm",
      "inputs": [
        "soft_small"
      ]
    },
    {
      "name": "wide_small",
      "op": "avgpool",
      "inputs": [
        "dilation"
      ],
      "size": [
        2,
        2
      ],
      "stride": [
        2,
        2
      ]
    },
    {
      "name": "wide_norm",
      "op": "norm",
      "inputs": [
        "wide_small"
      ]
    },
    {
      "name": "holes_small",
      "op": "avgpool",
      "inputs": [
        "enclosure"
      ],
      "size": [
        2,
        2
      ],
      "stride": [
        2,
        2
      ]
    },
    {
      "name": "holes_norm",
      "op": "norm",
      "inputs": [
        "holes_small"
      ]
    },
    {
      "name": "sharp_match",
      "op": "dense",
      "inputs": [
        "sharp_norm"
      ],
      "out": 81920
    },
    {
      "name": "soft_match",
      "op": "dense",
      "inputs": [
        "soft_norm"
      ],
      "out": 81920
    },
    {
      "name": "wide_match",
      "op": "dense",
      "inputs": [
        "wide_norm"
      ],
      "out": 81920
    },
    {
      "name": "holes_match",
      "op": "dense",
      "inputs": [
        "holes_norm"
      ],
      "out": 81920
    },
    {
      "name": "template_scores",
      "op": "add",
      "inputs": [
        "sharp_match",
        "soft_match",
        "wide_match",
        "holes_match"
      ]
    },
    {
      "name": "group_by_digit",
      "op": "reshape",
      "inputs": [
        "template_scores"
      ],
      "shape": [
        10,
        1,
        8192
      ]
    },
    {
      "name": "best_writing_style",
      "op": "maxpool",
      "inputs": [
        "group_by_digit"
      ],
      "size": [
        1,
        8192
      ],
      "stride": [
        1,
        8192
      ]
    },
    {
      "name": "scores",
      "op": "reshape",
      "inputs": [
        "best_writing_style"
      ],
      "shape": [
        10
      ]
    }
  ]
}