      ]
    },
    {
      "name": "pair_difference",
      "op": "conv",
      "inputs": [
        "negative_clipped"
      ],
      "out": 2,
      "kernel": [
        1,
        1
      ],
      "stride": 1,
      "padding": 0
    },
    {
      "name": "pair_difference_relu",
      "op": "relu",
      "inputs": [
        "pair_difference"
      ]
    },
    {
      "name": "pair_base",
      "op": "conv",
      "inputs": [
