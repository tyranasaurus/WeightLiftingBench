      ],
      "out": 2,
      "kernel": [
        1,
        1
      ],
      "stride": 1,
      "padding": 0
    },
    {
      "name": "pair_max",
      "op": "add",
      "inputs": [
        "pair_base",
        "pair_difference_relu"
      ]
    },
    {
      "name": "last_difference",
      "op": "conv",
      "inputs": [
        "pair_max"
      ],
      "out": 1,
      "kernel": [
        1,
        1
      ],
      "stride": 1,
      "padding": 0
    },
    {
      "name": "last_difference_relu",
      "op": "relu",
      "inputs": [
        "last_difference"
      ]
    },
    {
      "name": "last_base",
      "op": "conv",
      "inputs": [
        "pair_max"
      ],
      "out": 1,
      "kernel": [
        1,
        1
      ],
      "stride": 1,
      "padding": 0
    },
    {
      "name": "negative_minimum",
      "op": "add",
      "inputs": [
        "last_base",
        "last_difference_relu"
      ]
    },
    {
      "name": "minimum_rays",
      "op": "conv",
      "inputs": [
        "negative_minimum"
      ],
      "out": 1,
      "kernel": [
        1,
        1
      ],
      "stride": 1,
      "padding": 0
    },
    {
      "name": "negative_ink",
      "op": "conv",
      "inputs": [
        "image"
      ],
      "out": 1,
      "kernel": [
        1,
        1
      ],
      "stride": 1,
      "padding": 0
    },
    {
      "name": "empty_blocked_regions",
      "op": "add",
      "inputs": [
        "minimum_rays",
