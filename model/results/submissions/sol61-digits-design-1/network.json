{
  "layers": [
    {
      "name": "border",
      "op": "conv",
      "inputs": [
        "image"
      ],
      "out": 1,
      "kernel": [
        1,
        1
      ],
      "stride": 1,
      "padding": 1
    },
    {
      "name": "dilation",
      "op": "maxpool",
      "inputs": [
        "border"
      ],
      "size": [
        3,
        3
      ],
      "stride": [
        1,
        1
      ]
    },
    {
      "name": "blur",
      "op": "conv",
      "inputs": [
        "image"
      ],
      "out": 1,
      "kernel": [
        3,
        3
      ],
      "stride": 1,
      "padding": 1
    },
    {
      "name": "rays",
      "op": "conv",
      "inputs": [
        "image"
      ],
      "out": 4,
      "kernel": [
        19,
        19
      ],
      "stride": 1,
      "padding": 9
    },
    {
      "name": "ray_excess",
      "op": "conv",
      "inputs": [
        "rays"
      ],
      "out": 4,
      "kernel": [
        1,
        1
      ],
      "stride": 1,
      "padding": 0
    },
    {
      "name": "ray_excess_relu",
      "op": "relu",
      "inputs": [
        "ray_excess"
      ]
    },
    {
      "name": "negative_rays",
      "op": "conv",
      "inputs": [
        "rays"
      ],
      "out": 4,
      "kernel": [
        1,
        1
      ],
      "stride": 1,
      "padding": 0
    },
    {
      "name": "negative_clipped",
      "op": "add",
      "inputs": [
        "ray_excess_relu",
