{
  "layers": [
    {
      "name": "conv_a",
      "op": "conv",
      "inputs": [
        "image"
      ],
      "out": 14,
      "kernel": [
        1,
        1
      ],
      "stride": 1,
      "padding": 0
    },
    {
      "name": "relu_a",
      "op": "relu",
      "inputs": [
        "conv_a"
      ]
    },
    {
      "name": "conv_b",
      "op": "conv",
      "inputs": [
        "relu_a"
      ],
      "out": 1,
      "kernel": [
        1,
        1
      ],
      "stride": 1,
      "padding": 0
