{
  "layers": [
    {
      "name": "thresholds",
      "op": "conv",
      "inputs": [
        "image"
      ],
      "out": 3,
      "kernel": [
        1,
        1
      ],
      "stride": 1,
      "padding": 0
    },
    {
      "name": "positive",
      "op": "relu",
      "inputs": [
        "thresholds"
      ]
    },
    {
      "name": "occupancy",
      "op": "conv",
      "inputs": [
        "positive"
      ],
      "out": 1,
      "kernel": [
        1,
        1
      ],
      "stride": 1,
      "padding": 0
    },
    {
      "name": "blur",
      "op": "conv",
      "inputs": [
        "occupancy"
      ],
      "out": 1,
      "kernel": [
        3,
        3
      ],
      "stride": 1,
      "padding": 1
    },
    {
      "name": "match",
      "op": "dense",
      "inputs": [
        "blur"
      ],
      "out": 9600
    },
    {
      "name": "by_class",
      "op": "reshape",
      "inputs": [
        "match"
      ],
      "shape": [
        1,
        10,
        960
      ]
    },
    {
      "name": "best",
      "op": "maxpool",
      "inputs": [
        "by_class"
      ],
      "size": [
        1,
        960
      ],
      "stride": [
        1,
        960
      ]
    },
    {
      "name": "scores",
      "op": "reshape",
      "inputs": [
        "best"
      ],
      "shape": [
        10
      ]
    }
  ]
}
