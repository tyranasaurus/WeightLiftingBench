      ]
    },
    {
      "name": "dark_n",
      "op": "norm",
      "inputs": [
        "dark_relu"
      ]
    },
    {
      "name": "seg_light_corr",
      "op": "dense",
      "inputs": [
        "light_n"
      ],
      "out": 28800
    },
    {
      "name": "seg_dark_corr",
      "op": "dense",
      "inputs": [
        "dark_n"
      ],
      "out": 28800
    },
    {
      "name": "raw_grid",
      "op": "reshape",
      "inputs": [
        "raw_corr"
      ],
      "shape": [
        24,
        1200,
        1
      ]
    },
    {
