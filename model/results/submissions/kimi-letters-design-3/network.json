      "inputs": [
        "smooth"
      ],
      "size": [
        2,
        2
      ],
      "stride": [
        2,
        2
      ]
    },
    {
      "name": "pool_n",
      "op": "norm",
      "inputs": [
        "pool"
      ]
    },
    {
      "name": "coarse_corr",
      "op": "dense",
      "inputs": [
        "pool_n"
      ],
      "out": 28800
    },
    {
      "name": "light_shift",
      "op": "conv",
      "inputs": [
        "smooth_n"
      ],
      "out": 1,
      "kernel": [
        1,
        1
      ],
      "stride": 1,
      "padding": 0
    },
    {
      "name": "light_relu",
      "op": "relu",
      "inputs": [
        "light_shift"
      ]
    },
    {
      "name": "light_n",
      "op": "norm",
      "inputs": [
