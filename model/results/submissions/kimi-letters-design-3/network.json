{
  "layers": [
    {
      "name": "smooth",
      "op": "conv",
      "inputs": [
        "image"
      ],
      "out": 1,
      "kernel": [
        5,
        5
      ],
      "stride": 1,
      "padding": 2
    },
    {
      "name": "smooth_n",
      "op": "norm",
      "inputs": [
        "smooth"
      ]
    },
    {
      "name": "raw_corr",
      "op": "dense",
      "inputs": [
        "smooth_n"
      ],
      "out": 28800
