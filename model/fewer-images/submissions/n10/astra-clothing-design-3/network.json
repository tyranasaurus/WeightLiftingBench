{
  "layers": [
    {
      "name": "intensity_knots",
      "op": "conv",
      "inputs": [
        "image"
      ],
      "out": 4,
      "kernel": [
        1,
        1
      ],
      "stride": 1,
      "padding": 0
    },
    {
      "name": "above_knots",
      "op": "relu",
      "inputs": [
        "intensity_knots"
      ]
    },
    {
      "name": "foreground",
      "op": "conv",
      "inputs": [
        "above_knots"
      ],
      "out": 1,
      "kernel": [
        1,
        1
      ],
      "stride": 1,
      "padding": 0
    },
    {
      "name": "shape_small",
      "op": "avgpool",
      "inputs": [
        "foreground"
      ],
      "size": [
        2,
        2
      ],
      "stride": [
        2,
        2
      ]
    },
    {
      "name": "shape_unit",
      "op": "norm",
      "inputs": [
        "shape_small"
      ]
    },
    {
      "name": "tone_small",
      "op": "avgpool",
      "inputs": [
        "image"
      ],
      "size": [
        2,
        2
      ],
      "stride": [
        2,
        2
      ]
    },
    {
      "name": "tone_unit",
      "op": "norm",
      "inputs": [
        "tone_small"
      ]
    },
    {
      "name": "tone_fraction",
      "op": "conv",
      "inputs": [
        "tone_unit"
      ],
      "out": 1,
      "kernel": [
        1,
        1
      ],
      "stride": 1,
      "padding": 0
    },
    {
      "name": "shape_fraction",
      "op": "conv",
      "inputs": [
        "shape_unit"
      ],
      "out": 1,
      "kernel": [
        1,
        1
      ],
      "stride": 1,
      "padding": 0
    },
    {
      "name": "appearance",
      "op": "add",
      "inputs": [
        "shape_fraction",
        "tone_fraction"
      ]
    },
    {
      "name": "drawings",
      "op": "dense",
      "inputs": [
        "appearance"
      ],
      "out": 20480
    },
    {
      "name": "by_class",
      "op": "reshape",
      "inputs": [
        "drawings"
      ],
      "shape": [
        10,
        1,
        2048
      ]
    },
    {
      "name": "style_matches",
      "op": "maxpool",
      "inputs": [
        "by_class"
      ],
      "size": [
        1,
        256
      ],
      "stride": [
        1,
        256
      ]
    },
    {
      "name": "closest",
      "op": "maxpool",
      "inputs": [
        "style_matches"
      ],
      "size": [
        1,
        8
      ],
      "stride": [
        1,
        8
      ]
    },
    {
      "name": "stable",
      "op": "avgpool",
      "inputs": [
        "style_matches"
      ],
      "size": [
        1,
        8
      ],
      "stride": [
        1,
        8
      ]
    },
    {
      "name": "best_match_scores",
      "op": "dense",
      "inputs": [
        "closest"
      ],
      "out": 10
    },
    {
      "name": "consensus_scores",
      "op": "dense",
      "inputs": [
        "stable"
      ],
      "out": 10
    },
    {
      "name": "shape_scores",
      "op": "add",
      "inputs": [
        "best_match_scores",
        "consensus_scores"
      ]
    },
    {
      "name": "footwear_classes",
      "op": "dense",
      "inputs": [
        "shape_scores"
      ],
      "out": 3
    },
    {
      "name": "footwear_shape_axis",
      "op": "reshape",
      "inputs": [
        "footwear_classes"
      ],
      "shape": [
        1,
        1,
        3
      ]
    },
    {
      "name": "footwear_shape_best",
      "op": "maxpool",
      "inputs": [
        "footwear_shape_axis"
      ],
      "size": [
        1,
        3
      ],
      "stride": [
        1,
        1
      ]
    },
    {
      "name": "not_footwear_classes",
      "op": "dense",
      "inputs": [
        "shape_scores"
      ],
      "out": 7
    },
    {
      "name": "not_footwear_shape_axis",
      "op": "reshape",
      "inputs": [
        "not_footwear_classes"
      ],
      "shape": [
        1,
        1,
        7
      ]
    },
    {
      "name": "not_footwear_shape_best",
      "op": "maxpool",
      "inputs": [
        "not_footwear_shape_axis"
      ],
      "size": [
        1,
        7
      ],
      "stride": [
        1,
        1
      ]
    },
    {
      "name": "footwear_side",
      "op": "dense",
      "inputs": [
        "footwear_shape_best"
      ],
      "out": 1
    },
    {
      "name": "object_side",
      "op": "dense",
      "inputs": [
        "not_footwear_shape_best"
      ],
      "out": 1
    },
    {
      "name": "footwear_lead",
      "op": "add",
      "inputs": [
        "footwear_side",
        "object_side"
      ]
    },
    {
      "name": "footwear_disagreement",
      "op": "dense",
      "inputs": [
        "footwear_lead"
      ],
      "out": 1
    },
    {
      "name": "footwear_deficit",
      "op": "relu",
      "inputs": [
        "footwear_disagreement"
      ]
    },
    {
      "name": "footwear_gate",
      "op": "dense",
      "inputs": [
        "footwear_deficit"
      ],
      "out": 1
    },
    {
      "name": "relative_tone",
      "op": "norm",
      "inputs": [
        "image"
      ]
    },
    {
      "name": "line_contrast",
      "op": "conv",
      "inputs": [
        "relative_tone"
      ],
      "out": 8,
      "kernel": [
        5,
        5
      ],
      "stride": 1,
      "padding": 2
    },
    {
      "name": "line_contrast_rect",
      "op": "relu",
      "inputs": [
        "line_contrast"
      ]
    },
    {
      "name": "strap_edges",
      "op": "conv",
      "inputs": [
        "foreground"
      ],
      "out": 1,
      "kernel": [
        5,
        5
      ],
      "stride": 1,
      "padding": 2
    },
    {
      "name": "open_strand",
      "op": "relu",
      "inputs": [
        "strap_edges"
      ]
    },
    {
      "name": "measure_relative_tone",
      "op": "dense",
      "inputs": [
        "relative_tone"
      ],
      "out": 34
    },
    {
      "name": "measure_line_contrast_rect",
      "op": "dense",
      "inputs": [
        "line_contrast_rect"
      ],
      "out": 34
    },
    {
      "name": "measure_image",
      "op": "dense",
      "inputs": [
        "image"
      ],
      "out": 34
    },
    {
      "name": "measure_foreground",
      "op": "dense",
      "inputs": [
        "foreground"
      ],
      "out": 34
    },
    {
      "name": "measure_open_strand",
      "op": "dense",
      "inputs": [
        "open_strand"
      ],
      "out": 34
    },
    {
      "name": "measurements",
      "op": "add",
      "inputs": [
        "measure_relative_tone",
        "measure_line_contrast_rect",
        "measure_image",
        "measure_foreground",
        "measure_open_strand"
      ]
    },
    {
      "name": "sandal_affinity",
      "op": "dense",
      "inputs": [
        "footwear_gate"
      ],
      "out": 39
    },
    {
      "name": "direct_cues",
      "op": "dense",
      "inputs": [
        "measurements"
      ],
      "out": 39
    },
    {
      "name": "front_select",
      "op": "dense",
      "inputs": [
        "measurements"
      ],
      "out": 15
    },
    {
      "name": "front_axis",
      "op": "reshape",
      "inputs": [
        "front_select"
      ],
      "shape": [
        1,
        1,
        15
      ]
    },
    {
      "name": "front_max",
      "op": "maxpool",
      "inputs": [
        "front_axis"
      ],
      "size": [
        1,
        15
      ],
      "stride": [
        1,
        1
      ]
    },
    {
      "name": "front_cue",
      "op": "dense",
      "inputs": [
        "front_max"
      ],
      "out": 39
    },
    {
      "name": "vent_select",
      "op": "dense",
      "inputs": [
        "measurements"
      ],
      "out": 3
    },
    {
      "name": "vent_axis",
      "op": "reshape",
      "inputs": [
        "vent_select"
      ],
      "shape": [
        1,
        1,
        3
      ]
    },
    {
      "name": "vent_max",
      "op": "maxpool",
      "inputs": [
        "vent_axis"
      ],
      "size": [
        1,
        3
      ],
      "stride": [
        1,
        1
      ]
    },
    {
      "name": "vent_cue",
      "op": "dense",
      "inputs": [
        "vent_max"
      ],
      "out": 39
    },
    {
      "name": "vee_select",
      "op": "dense",
      "inputs": [
        "measurements"
      ],
      "out": 3
    },
    {
      "name": "vee_axis",
      "op": "reshape",
      "inputs": [
        "vee_select"
      ],
      "shape": [
        1,
        1,
        3
      ]
    },
    {
      "name": "vee_max",
      "op": "maxpool",
      "inputs": [
        "vee_axis"
      ],
      "size": [
        1,
        3
      ],
      "stride": [
        1,
        1
      ]
    },
    {
      "name": "vee_cue",
      "op": "dense",
      "inputs": [
        "vee_max"
      ],
      "out": 39
    },
    {
      "name": "seam_select",
      "op": "dense",
      "inputs": [
        "measurements"
      ],
      "out": 6
    },
    {
      "name": "seam_axis",
      "op": "reshape",
      "inputs": [
        "seam_select"
      ],
      "shape": [
        1,
        1,
        6
      ]
    },
    {
      "name": "seam_max",
      "op": "maxpool",
      "inputs": [
        "seam_axis"
      ],
      "size": [
        1,
        6
      ],
      "stride": [
        1,
        1
      ]
    },
    {
      "name": "seam_cue",
      "op": "dense",
      "inputs": [
        "seam_max"
      ],
      "out": 39
    },
    {
      "name": "garment_cues",
      "op": "add",
      "inputs": [
        "sandal_affinity",
        "direct_cues",
        "front_cue",
        "vent_cue",
        "vee_cue",
        "seam_cue"
      ]
    },
    {
      "name": "cue_thresholds",
      "op": "dense",
      "inputs": [
        "garment_cues"
      ],
      "out": 24
    },
    {
      "name": "cue_strength",
      "op": "relu",
      "inputs": [
        "cue_thresholds"
      ]
    },
    {
      "name": "detail_scores",
      "op": "dense",
      "inputs": [
        "cue_strength"
      ],
      "out": 10
    },
    {
      "name": "fine_scores",
      "op": "add",
      "inputs": [
        "shape_scores",
        "detail_scores"
      ]
    },
    {
      "name": "upper_classes",
      "op": "dense",
      "inputs": [
        "shape_scores"
      ],
      "out": 4
    },
    {
      "name": "upper_shape_axis",
      "op": "reshape",
      "inputs": [
        "upper_classes"
      ],
      "shape": [
        1,
        1,
        4
      ]
    },
    {
      "name": "upper_shape_best",
      "op": "maxpool",
      "inputs": [
        "upper_shape_axis"
      ],
      "size": [
        1,
        4
      ],
      "stride": [
        1,
        1
      ]
    },
    {
      "name": "upper_fine_select",
      "op": "dense",
      "inputs": [
        "fine_scores"
      ],
      "out": 4
    },
    {
      "name": "upper_fine_axis",
      "op": "reshape",
      "inputs": [
        "upper_fine_select"
      ],
      "shape": [
        1,
        1,
        4
      ]
    },
    {
      "name": "upper_fine_best",
      "op": "maxpool",
      "inputs": [
        "upper_fine_axis"
      ],
      "size": [
        1,
        4
      ],
      "stride": [
        1,
        1
      ]
    },
    {
      "name": "upper_coarse_route",
      "op": "dense",
      "inputs": [
        "upper_shape_best"
      ],
      "out": 10
    },
    {
      "name": "upper_fine_route",
      "op": "dense",
      "inputs": [
        "upper_fine_best"
      ],
      "out": 10
    },
    {
      "name": "shoe_classes",
      "op": "dense",
      "inputs": [
        "shape_scores"
      ],
      "out": 3
    },
    {
      "name": "shoe_shape_axis",
      "op": "reshape",
      "inputs": [
        "shoe_classes"
      ],
      "shape": [
        1,
        1,
        3
      ]
    },
    {
      "name": "shoe_shape_best",
      "op": "maxpool",
      "inputs": [
        "shoe_shape_axis"
      ],
      "size": [
        1,
        3
      ],
      "stride": [
        1,
        1
      ]
    },
    {
      "name": "shoe_fine_select",
      "op": "dense",
      "inputs": [
        "fine_scores"
      ],
      "out": 3
    },
    {
      "name": "shoe_fine_axis",
      "op": "reshape",
      "inputs": [
        "shoe_fine_select"
      ],
      "shape": [
        1,
        1,
        3
      ]
    },
    {
      "name": "shoe_fine_best",
      "op": "maxpool",
      "inputs": [
        "shoe_fine_axis"
      ],
      "size": [
        1,
        3
      ],
      "stride": [
        1,
        1
      ]
    },
    {
      "name": "shoe_coarse_route",
      "op": "dense",
      "inputs": [
        "shoe_shape_best"
      ],
      "out": 10
    },
    {
      "name": "shoe_fine_route",
      "op": "dense",
      "inputs": [
        "shoe_fine_best"
      ],
      "out": 10
    },
    {
      "name": "scores",
      "op": "add",
      "inputs": [
        "fine_scores",
        "upper_coarse_route",
        "upper_fine_route",
        "shoe_coarse_route",
        "shoe_fine_route"
      ]
    }
  ]
}
