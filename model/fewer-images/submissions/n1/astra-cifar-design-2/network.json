{
  "layers": [
    {
      "name": "gradient",
      "op": "conv",
      "inputs": [
        "image"
      ],
      "out": 8,
      "kernel": [
        3,
        3
      ],
      "padding": 0,
      "stride": 1
    },
    {
      "name": "half_waves",
      "op": "relu",
      "inputs": [
        "gradient"
      ]
    },
    {
      "name": "angle_tuning",
      "op": "conv",
      "inputs": [
        "half_waves"
      ],
      "out": 4,
      "kernel": [
        1,
        1
      ],
      "padding": 0,
      "stride": 1
    },
    {
      "name": "oriented_edges",
      "op": "relu",
      "inputs": [
        "angle_tuning"
      ]
    },
    {
      "name": "orientation_histograms",
      "op": "avgpool",
