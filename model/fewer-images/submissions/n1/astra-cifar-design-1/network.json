   "op": "avgpool",
   "inputs": [
    "image"
   ],
   "size": [
    2,
    2
   ],
   "stride": [
    2,
    2
   ]
  },
  {
   "name": "chromatic_halfspaces",
   "op": "conv",
   "inputs": [
