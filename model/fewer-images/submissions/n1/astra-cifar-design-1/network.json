   "inputs": [
    "clip_offset"
   ]
  },
  {
   "name": "remove_excess",
   "op": "conv",
   "inputs": [
    "orientation_excess"
   ],
   "out": 8,
   "kernel": [
    1,
    1
   ],
   "stride": 1,
   "padding": 0
  },
  {
   "name": "oriented_cells",
   "op": "add",
   "inputs": [
    "orientation_positive",
    "remove_excess"
   ]
  },
  {
   "name": "orientation_layout",
   "op": "norm",
   "inputs": [
    "oriented_cells"
   ]
  },
  {
   "name": "coarse_luminance",
   "op": "avgpool",
   "inputs": [
    "local_luminance"
   ],
   "size": [
    4,
    4
   ],
   "stride": [
    4,
    4
   ]
  },
  {
   "name": "luminance_layout",
   "op": "norm",
   "inputs": [
    "coarse_luminance"
   ]
  },
  {
   "name": "shape_histogram_vote",
   "op": "dense",
   "inputs": [
    "orientation_layout"
   ],
   "out": 6000
  },
  {
   "name": "shape_shading_vote",
   "op": "dense",
   "inputs": [
    "luminance_layout"
   ],
   "out": 6000
  },
  {
   "name": "matched_illustrations",
   "op": "add",
   "inputs": [
    "shape_histogram_vote",
    "shape_shading_vote"
   ]
  },
  {
   "name": "illustrated_hypotheses",
   "op": "reshape",
   "inputs": [
    "matched_illustrations"
   ],
   "shape": [
    10,
    1,
    600
   ]
  },
  {
   "name": "best_pose",
   "op": "maxpool",
   "inputs": [
    "illustrated_hypotheses"
   ],
   "size": [
    1,
    600
   ],
   "stride": [
    1,
    600
   ]
  },
  {
   "name": "best_in_groups",
   "op": "maxpool",
   "inputs": [
    "illustrated_hypotheses"
   ],
   "size": [
    1,
    50
   ],
   "stride": [
    1,
    50
   ]
  },
  {
   "name": "group_consensus",
   "op": "avgpool",
   "inputs": [
    "best_in_groups"
   ],
   "size": [
    1,
    12
   ],
   "stride": [
    1,
    12
   ]
  },
  {
   "name": "peak_shape",
   "op": "dense",
   "inputs": [
    "best_pose"
   ],
   "out": 10
  },
  {
   "name": "consistent_shape",
   "op": "dense",
   "inputs": [
    "group_consensus"
   ],
   "out": 10
  },
  {
   "name": "shape_scores",
   "op": "add",
   "inputs": [
    "peak_shape",
    "consistent_shape"
   ]
  },
  {
