   ],
   "shape": [
    1,
    1,
    96
   ]
  },
  {
   "name": "facial_triangle_peak",
   "op": "maxpool",
   "inputs": [
    "facial_triangle_bank"
   ],
   "size": [
    1,
    96
   ],
   "stride": [
    1,
    96
   ]
  },
  {
   "name": "read_color_map",
   "op": "dense",
   "inputs": [
    "color_map"
   ],
   "out": 193
  },
  {
   "name": "read_raw_edge_cells",
   "op": "dense",
   "inputs": [
    "raw_edge_cells"
   ],
   "out": 193
  },
  {
   "name": "read_overlapping_cells",
   "op": "dense",
   "inputs": [
    "overlapping_cells"
   ],
   "out": 193
  },
  {
   "name": "read_bar_edge_grid",
   "op": "dense",
   "inputs": [
    "bar_edge_grid"
   ],
   "out": 193
  },
  {
   "name": "read_mirror_differences",
   "op": "dense",
   "inputs": [
    "mirror_differences"
   ],
   "out": 193
  },
  {
   "name": "read_wheel_pair_peak",
   "op": "dense",
   "inputs": [
    "wheel_pair_peak"
   ],
   "out": 193
  },
  {
   "name": "read_facial_triangle_peak",
   "op": "dense",
   "inputs": [
    "facial_triangle_peak"
   ],
   "out": 193
