{
 "layers": [
  {
   "name": "luminance",
   "op": "conv",
   "inputs": [
    "image"
   ],
   "out": 1,
   "kernel": [
    1,
    1
   ],
   "stride": 1,
   "padding": 0
  },
  {
   "name": "local_luminance",
   "op": "norm",
   "inputs": [
    "luminance"
   ]
  },
  {
   "name": "signed_gradients",
   "op": "conv",
   "inputs": [
    "local_luminance"
   ],
   "out": 8,
   "kernel": [
    3,
    3
   ],
   "stride": 1,
   "padding": 0
  },
  {
   "name": "gradient_magnitudes",
   "op": "relu",
   "inputs": [
    "signed_gradients"
   ]
  },
  {
   "name": "overlapping_cells",
   "op": "avgpool",
   "inputs": [
    "gradient_magnitudes"
   ],
   "size": [
    6,
    6
   ],
   "stride": [
    3,
    3
   ]
  },
  {
   "name": "orientation_competition",
   "op": "conv",
   "inputs": [
    "overlapping_cells"
   ],
   "out": 8,
   "kernel": [
    1,
    1
   ],
   "stride": 1,
   "padding": 0
  },
  {
   "name": "orientation_positive",
   "op": "relu",
   "inputs": [
    "orientation_competition"
   ]
  },
  {
   "name": "clip_offset",
   "op": "conv",
   "inputs": [
