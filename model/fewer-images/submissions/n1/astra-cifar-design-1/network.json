    1,
    72
   ]
  },
  {
   "name": "wheel_pair_peak",
   "op": "maxpool",
   "inputs": [
    "wheel_pair_bank"
   ],
   "size": [
    1,
    72
   ],
   "stride": [
    1,
    72
   ]
  },
  {
   "name": "facial_triangle_contrasts",
   "op": "dense",
   "inputs": [
    "symmetry_cells"
   ],
   "out": 96
