   ]
  },
  {
   "name": "context_votes",
   "op": "dense",
   "inputs": [
    "supported_context"
   ],
   "out": 10
  },
  {
   "name": "class_scores",
   "op": "add",
   "inputs": [
    "shape_scores",
    "individual_cues",
    "context_votes"
   ]
  }
 ]
}
