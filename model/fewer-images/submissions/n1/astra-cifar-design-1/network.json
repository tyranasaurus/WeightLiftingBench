  {
   "name": "observations",
   "op": "add",
   "inputs": [
    "read_color_map",
    "read_raw_edge_cells",
    "read_overlapping_cells",
    "read_bar_edge_grid",
    "read_mirror_differences",
    "read_wheel_pair_peak",
    "read_facial_triangle_peak"
   ]
  },
  {
   "name": "attribute_thresholds",
   "op": "dense",
   "inputs": [
