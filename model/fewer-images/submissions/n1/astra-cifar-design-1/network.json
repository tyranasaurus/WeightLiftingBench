    1
   ],
   "stride": 1,
   "padding": 0
  },
  {
   "name": "color_ramps",
   "op": "relu",
   "inputs": [
    "chromatic_halfspaces"
   ]
  },
  {
   "name": "color_intersections",
   "op": "conv",
   "inputs": [
    "color_ramps"
   ],
   "out": 12,
   "kernel": [
    1,
    1
   ],
   "stride": 1,
   "padding": 0
  },
  {
   "name": "color_memberships",
   "op": "relu",
   "inputs": [
    "color_intersections"
   ]
  },
  {
   "name": "color_map",
   "op": "avgpool",
   "inputs": [
    "color_memberships"
   ],
   "size": [
    2,
    2
   ],
   "stride": [
    2,
    2
   ]
  },
  {
   "name": "raw_edge_filters",
   "op": "conv",
   "inputs": [
    "luminance"
   ],
   "out": 10,
   "kernel": [
    3,
    3
   ],
   "stride": 1,
   "padding": 0
  },
  {
   "name": "raw_edge_halves",
   "op": "relu",
   "inputs": [
    "raw_edge_filters"
   ]
  },
  {
   "name": "raw_edge_cells",
   "op": "avgpool",
   "inputs": [
    "raw_edge_halves"
   ],
   "size": [
    6,
    6
   ],
   "stride": [
    3,
    3
   ]
  },
  {
   "name": "bar_edges",
   "op": "conv",
   "inputs": [
    "local_luminance"
   ],
   "out": 8,
   "kernel": [
    7,
    7
   ],
   "stride": 2,
   "padding": 0
  },
  {
   "name": "long_edge_halves",
   "op": "relu",
   "inputs": [
    "bar_edges"
   ]
  },
  {
   "name": "bar_edge_grid",
   "op": "avgpool",
   "inputs": [
    "long_edge_halves"
   ],
   "size": [
    3,
    3
   ],
   "stride": [
    2,
    2
   ]
  },
  {
   "name": "symmetry_cells",
   "op": "avgpool",
   "inputs": [
    "local_luminance"
   ],
   "size": [
    2,
    2
   ],
   "stride": [
    2,
    2
   ]
  },
  {
   "name": "mirror_pairs",
   "op": "dense",
   "inputs": [
    "symmetry_cells"
   ],
   "out": 234
  },
  {
   "name": "mirror_differences",
   "op": "relu",
   "inputs": [
